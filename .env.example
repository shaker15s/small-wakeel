# وكيل (Wakil) — environment template. Copy to `.env` (never commit real secrets).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file. Relative paths resolve against the process working directory.
# The app has a built-in default (`file:./db/custom.db`) so this is optional
# for local development.
DATABASE_URL=file:./db/custom.db

# ---------------------------------------------------------------------------
# Access control (production identity is mandatory)
# ---------------------------------------------------------------------------
# Development demo only. Ignored as authentication in production.
# WAKIL_ACCESS_TOKEN=

# Production / controlled pilot: JSON array of per-user hashed credentials.
# Each record has userId (existing DB user), tokenHash (SHA-256 lowercase hex),
# and optionally admin:true for deployment administration. Never put raw tokens
# in this variable, Git, chat or sharing URLs. See docs/SECURITY.md.
# Missing/malformed pilot configuration refuses pilot credentials; native SaaS sessions
# are a separate identity path. Owners are never deployment administrators.
# WAKIL_AUTH_CREDENTIALS=

# External AES-256-GCM key: exactly 64 hex characters, stored outside SQLite.
# Shared by provider keys, MFA/pending-MFA secrets and encrypted mail.
# Migrate legacy plaintext provider keys offline before enabling them in production.
# WAKIL_SECRETS_KEY=
# For offline key rotation only (never required by the running web server):
# WAKIL_NEW_SECRETS_KEY=

# Raw admin credential for container/operator health probes; keep private.
# WAKIL_HEALTH_TOKEN=

# Comma-separated list of browser origins allowed to POST (CSRF defence).
# Defaults to same-origin requests only.
# WAKIL_ALLOWED_ORIGINS=https://wakil.example.com

# Requests per minute per IP/route: read 600, write 120, chat 40 (burst 120/40/12).
# WAKIL_RATE_LIMIT=120
# WAKIL_RATE_LIMIT_CHAT=30

# ---------------------------------------------------------------------------
# Native SaaS (opt-in; see docs/SAAS.md)
# ---------------------------------------------------------------------------
WAKIL_SAAS_ENABLED=0
WAKIL_SIGNUP_ENABLED=0
# Canonical HTTPS public origin, also used for fragment-based action links:
# WAKIL_APP_URL=https://your-domain.example
# A real public HTTPS JSON mail gateway; {to,subject,text}, Bearer + idempotency key.
# Format readiness is NOT successful-delivery proof. No fake delivery fallback.
# WAKIL_MAIL_ENDPOINT=https://your-mail-gateway.example/send
# WAKIL_MAIL_TOKEN=  # privately provision at least 16 characters; never commit
# WAKIL_SECRETS_KEY above is mandatory for signup/outbox/MFA.
# Schedule `bun run mail:deliver` every minute against the same durable DB/key.
# Default: 14-day trial, 5 seats, 50 chat HTTP attempts/day/workspace (UTC).
# No electronic payments. Only explicit audited operator contract administration.

# ---------------------------------------------------------------------------
# Agent / models
# ---------------------------------------------------------------------------
# Built-in models (glm-4.6 / glm-4.5-air via z-ai-web-dev-sdk) read their
# credentials from the SDK config file the platform provides (.z-ai-config).
# Without it the agent still works — it falls back to the deterministic
# rule-based ladder. Bring-your-own OpenAI-compatible providers are configured
# by deployment admins via public HTTPS. Keys are encrypted in production.

# DEV ONLY escape hatch; ignored in production. No local-provider bypass.
# ALLOW_LOCAL_WEBHOOKS=0

# Verbose SQL logging: `query` prints every statement (dev only).
# WAKIL_DB_LOG=query

# In-process scheduler: do not claim durable jobs in serverless/multi-instance hosting.
# Enabled by default in code; keep OFF for an unvalidated pilot deployment.
WAKIL_SCHEDULER=off
# WAKIL_SCHEDULER_INTERVAL_MS=60000

# Strict approvals: every R1/R2 draft needs an owner or supervisor.
# Management may approve its own drafts: this is NOT four-eyes segregation.
# WAKIL_STRICT_APPROVALS=0

# Deterministic offline mode: every model call fails instantly so the agent
# uses its rule-based Arabic ladder (air-gapped installs, evals, CI smoke tests).
# WAKIL_OFFLINE=0

# ---------------------------------------------------------------------------
# DeepSeek Harness — local WAKIL bridge (disabled unless explicitly enabled)
# ---------------------------------------------------------------------------
# When enabled, DSH may read the configured owner's ledger and create
# AWAITING_APPROVAL drafts only. The bridge has NO approve/execute/delete tool.
# Generate a long random bearer token; keep the same value in the DSH process
# environment. Never commit a real token.
# WAKIL_DSH_ENABLED=0
# WAKIL_DSH_BRIDGE_TOKEN=
# WAKIL_DSH_BUSINESS_ID=
# WAKIL_DSH_USER_ID=
# DSH side: WAKIL_DSH_BRIDGE_TOKEN=<same token>
# DSH side: WAKIL_DSH_BASE_URL=http://127.0.0.1:3000  # local dev only
