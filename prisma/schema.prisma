// وكيل (Wakil) — Prisma schema
// Money is ALWAYS integer piastres (1 EGP = 100 piastres). Never floats.

generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id             String   @id @default(cuid())
  name           String
  type           String // supermarket | gym | pharmacy | attar
  workflowMode   String @default("inventory") // cashbook: no per-item cash sales required
  currency       String   @default("EGP")
  timezone       String   @default("Africa/Cairo")
  openingCash    Int      @default(0) // piastres
  opSeq          Int      @default(0)
  createdAt      DateTime @default(now())

  cashbookEntries CashbookEntry[]
  shopReminders ShopReminder[]
  workspacePreferences WorkspacePreference[]
  notifications TaskNotification[]
  users          User[]
  items          Item[]
  customers      Customer[]
  suppliers      Supplier[]
  operations     Operation[]
  cashEntries    CashEntry[]
  auditEvents    AuditEvent[]
  agentEvents    AgentEvent[]
  profile        BusinessProfile?
  conversations  Conversation[]
  scheduledTasks ScheduledTask[]
  memories       AgentMemory[]
  usageEvents    UsageEvent[]
  quickCommands  QuickCommand[]
  appHarnesses     AppHarness[]
  agentNotes     AgentNote[]
  pendingRequests PendingRequest[]
  subscriptions Subscription?
  invitations Invitation[]
  settings       AgentSettings?
  tools          CustomTool[] @relation("BusinessTools")
}

model User {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  role       String // owner | cashier | reception | supervisor
  title      String? // job title in Arabic
  createdAt  DateTime @default(now())
  tools      CustomTool[] @relation("UserTools")
  workspacePreferences WorkspacePreference[]
  membership Membership?
}

model Item {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  aliases           String    @default("") // comma-separated alt names
  unit              String // piece | kg | gram | liter | milli | box | strip | capsule | session
  category          String    @default("")
  costPrice         Int? // piastres per unit — NULL = غير مسجل (R70: unknown stays unknown, never invented)
  sellPrice         Int? // piastres per unit — NULL = غير مسجل (R70)
  stockQty          Int? // base unit (gram for attar, etc.) — NULL = quantity never counted (R70)
  lowStockThreshold Int? // NULL = no threshold set (R70: a made-up threshold fakes shortages)
  barcode           String? // scanned at the counter (EAN-13 / code-128 / QR)
  batchNo           String? // pharmacy
  expiresAt         DateTime? // pharmacy
  createdAt         DateTime  @default(now())

  @@index([businessId, name])
  @@index([businessId, barcode])
  @@index([businessId, stockQty])
  @@index([expiresAt])
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  balance    Int       @default(0) // + owes us; - credit
  plan       String? // gym plan name
  expiresAt  DateTime? // gym membership expiry
  createdAt  DateTime  @default(now())

  @@index([businessId, name])
  @@index([expiresAt])
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  balance    Int      @default(0) // + we owe them
  createdAt  DateTime @default(now())

  @@index([businessId, name])
}

model Operation {
  id             String    @id @default(cuid())
  cashbookEntry CashbookEntry?
  ref            String    @unique // WKL-1001
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type           String // sale | purchase | expense | collection | payment | stock_adjustment | membership | attendance | reversal
  status         String // RECEIVED | AWAITING_APPROVAL | EXECUTING | SUCCEEDED | FAILED_SAFE | OUTCOME_UNKNOWN | CANCELLED
  source         String    @default("chat") // chat | manual | task
  userId         String
  risk           String // R0 | R1 | R2 | R3 | R4
  summary        String
  payload        String // JSON — extracted fields
  result         String? // JSON — verification + outcome
  idempotencyKey String    @unique
  conversationId String?
  // R71 / PR-003 — approval binding (§20.4): the approved bytes are the
  // executed bytes. payloadHash = sha256 of the canonical payload at draft
  // time; expiresAt bounds how long an approval holds. Null on pre-R71 rows.
  payloadHash String?
  expiresAt DateTime?
  reversalOfRef  String?
  reversedByRef  String?
  reason         String?
  failReason     String?
  createdAt      DateTime  @default(now())
  executedAt     DateTime?
  decidedAt      DateTime?

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([conversationId])
  @@index([userId, createdAt])
}

model CashEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  direction  String // in | out
  amount     Int // piastres
  reason     String
  ref        String? // operation ref
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([ref])
}

model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor      String // userId or "agent"
  action     String // operation.created | operation.approved | ...
  ref        String?
  detail     String // JSON
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([ref])
}

// R73 / PR-005 (final plan v2 §20.6): append-only agent trace ledger.
// Every row is an APPEND — the module exposes no update/delete path, and
// the rows carry traceId/tenant/sequence so a request is reconstructable
// end to end. payload is REDACTED JSON (never raw conversation/secrets);
// sensitive blobs are referenced (operationRef) + hashed, not duplicated.
// R75 / PR-007 (final plan v2 §7.1): the onboarding state machine, one row
// per business. `answers` is JSON of the owner's OWN answers (source=owner,
// answeredAt, skipped) — financial facts only exist when the owner stated
// them; a skipped financial question stays unknown (null), never 0.
// `consents` is JSON of per-feature grants (file/photo import) recorded at
// the onboarding interview, honored by the import routes.
model BusinessProfile {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stage               String   @default("not_started") // not_started | interviewing | proposed | confirmed
  answers             String   @default("{}") // JSON { key: { value, source, answeredAt, skipped, corrected? } }
  consents            String   @default("{}") // JSON { key: { granted, at } }
  openingCashStatedAt DateTime? // set only when the owner stated an opening cash
  updatedAt           DateTime @default(now()) @updatedAt
}

model AgentEvent {
  id             String   @id @default(cuid())
  businessId     String // tenant — every query is tenant-scoped
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  traceId        String // one per turn
  conversationId String?
  sequence       Int // per-trace ordering
  type           String // turn.started | tool.proposed | tool.refused | ...
  actor          String // user | model | tool | scheduler | system
  payload        String // redacted JSON — raw secrets never land here
  operationRef   String? // WKL-#### when it applies
  payloadHash    String? // hash of the full (unredacted) payload when trimmed
  createdAt      DateTime @default(now())

  @@index([traceId, sequence])
  @@index([businessId, createdAt])
  @@index([operationRef])
}

model Conversation {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  title         String    @default("محادثة جديدة")
  pinned        Boolean   @default(false)
  archived      Boolean   @default(false)
  lastMessageAt DateTime  @default(now())
  messageCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cashbookDialogue CashbookDialogue?
  pendingRequest PendingRequest?
  messages      Message[]
  notes         AgentNote[]

  @@index([businessId, userId, updatedAt])
  @@index([businessId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  text           String
  card           String? // JSON — draft action card
  cards          String? // JSON — result cards (tables)
  thinking       String? // agent visible thinking steps
  actions        String? // JSON — deep-link action buttons (ChatActionDTO[])
    modelLabel     String?
  research       String? // JSON — ResearchDTO (deep-research plan + sources)
  verified       String? // JSON — VerifyDTO (self-verification result)
  /* The client's per-send id. A dropped SSE stream used to cost the owner a
     second identical message AND a second draft on «جرّب تاني»; with this id
     the retry reuses the turn (or replays the finished reply) instead. */
  clientTurnId   String?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, clientTurnId])
  @@index([conversationId, createdAt])
}

// «ورقة وقلم وكيل» — the agent's private scratchpad per conversation.
// Facts/hypotheses/TODOs jotted during tool runs; injected into future turns
// so the employee remembers his own working notes (Claude Code TODO lesson).
model AgentNote {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String       @default("fact") // fact | hypothesis | todo | plan | citation
  text           String
  source         String? // tool name / url the note came from
  pinned         Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([conversationId, active])
  @@index([businessId, userId, active])
}

model ScheduledTask {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  conversationId String?
  title          String
  tool           String
  fields         String // JSON
  whenLabel      String
  scheduledFor   DateTime
  recurrence     String? // daily | weekly | monthly
  status         String    @default("pending") // pending | running | retry_wait | done | failed | cancelled
  result         String?
  failReason     String?
  createdAt      DateTime  @default(now())
  executedAt     DateTime?
  /** set when a runner atomically claims the task (stuck-run recovery uses it) */
  claimedAt      DateTime?
  /** which worker holds the lease (PR-010 durable runner) */
  leaseOwner     String?
  /** bounded retry budget: a failed run waits until nextRetryAt, then retries */
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextRetryAt    DateTime?
  /** firing generation — keys the outbox row (crash-safe idempotency) */
  executionCount Int       @default(0)
  /** last COMPLETED step — the honest task box shows this + the next step */
  lastStep       String?

  notifications  TaskNotification[]

  @@index([status, scheduledFor])
  @@index([status, nextRetryAt])
  @@index([businessId, userId, status])
}

// PR-010 — transactional outbox: a task's result is delivered as a separately
// claimed/committed notification. «task finished» ≠ «notification delivered».
// The row id is deterministic (`tn_<taskId>_<generation>`) so a crashed and
// retried firing can never enqueue the same notification twice.
model TaskNotification {
  id             String    @id
  taskId         String
  task           ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  conversationId String?
  payload        String // JSON: { messageId, text, cards?, detail }
  status         String    @default("pending") // pending | sending | sent | failed
  attempts       Int       @default(0)
  claimedAt      DateTime?
  claimedBy      String?
  failReason     String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([taskId])
}

model AgentMemory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  kind       String // fact | preference | rule | lexicon | insight
  category   String   @default("general") // e.g. membership_policies | pricing | credit_limits
  text       String
  entityRef  String? // lexicon: canonical entity id (item/customer/supplier)
  confidence Int      @default(80) // 0-100
  usageCount Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([businessId, userId, active])
  @@index([businessId, kind])
}

// R46 — Mode 2 (CLI-Anything real): a learned/generated CLI harness for one
// of the owner's apps. Built on THIS machine with the owner's explicit
// permission (cli-hub prebuilt or the 7-phase pipeline), SKILL.md parsed,
// executable surface registered so the brain can drive the app.
model AppHarness {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String
  app          String // canonical app slug (excel, daftra, …)
  display      String // Arabic display name
  source       String // prebuilt | generated | native
  version      String   @default("1.0")
  skillMd      String // parsed SKILL.md: command groups JSON
  command      String // executable command prefix (cli-anything-<app>)
  argsTemplate String? // e.g. "--json {command} {args}"
  installedAt  DateTime @default(now())
  lastUsedAt   DateTime?
  status       String   @default("active") // active | broken | uninstalled

  @@unique([businessId, app])
  @@index([businessId, status])
}

model UsageEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  kind       String // tool | command | chat | suggestion_used | advisory | research | verify | reflection
  label      String // tool name / command text / suggestion id
  latencyMs  Int? // full turn latency (SpaceX-grade telemetry)
  ttftMs     Int? // time to first streamed token
  tokens     Int? // approximate tokens in the reply
  fallback   Boolean  @default(false) // true when a retry/backoff fallback fired
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, kind, createdAt])
}

model QuickCommand {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  label      String
  prompt     String
  icon       String   @default("spark") // spark | boxes | users | wallet | chart | book | today | alert
  sortOrder  Int      @default(0)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId, userId, sortOrder])
}

model ProviderCapability {
  id               String       @id @default(cuid())
  modelConfigId    String       @unique
  modelConfig      ModelConfig  @relation(fields: [modelConfigId], references: [id], onDelete: Cascade)
  ok               Boolean      @default(false)
  supportsStreaming Boolean      @default(false)
  supportsTools    Boolean      @default(false)
  ttftMs           Int?
  tps              Int?
  note             String?
  probedAt         DateTime     @default(now())
}

model AgentSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vertical   String // matches business type; behavior focus
  tone       String   @default("friendly") // friendly | formal
  updatedAt  DateTime @updatedAt
}

model ModelProvider {
  id        String        @id @default(cuid())
  name      String
  baseUrl   String // e.g. http://localhost:3031/v1
  apiKey    String
  createdAt DateTime      @default(now())
  models    ModelConfig[]
  speechSettings SpeechSettings[]
}

model ModelConfig {
  id           String             @id @default(cuid())
  providerId   String
  provider     ModelProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  remoteId     String // e.g. wakil-mock-deep
  label        String // Arabic display label
  tier         String // air | balanced | deep
  enabled      Boolean            @default(true)
  capabilities ProviderCapability?

  @@index([providerId, enabled])
}

// «أدوات بتاعتك» (R16) — user-extensible tools the AGENT actually uses:
// the shop owner adds his own web sources / webhooks and the deep-research
// pipeline runs them during the gather phase. Webhooks are READ-ONLY data
// fetches (SSRF-guarded, never executed, never auto-trigger actions).
model CustomTool {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  name       String // e.g. «أسعار المنظفات من موقع دروجال»
  kind       String // 'web_source' | 'webhook'
  config     String // JSON string — shapes documented in src/lib/agent/userTools.ts
  active     Boolean   @default(true)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation("BusinessTools", fields: [businessId], references: [id], onDelete: Cascade)
  user       User      @relation("UserTools", fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, active])
}

// SaaS identities are separate from per-business actors. Existing demo users
// are never silently claimed by matching email/name or assigned to an account.
model Account {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  verifiedAt DateTime?
  disabledAt DateTime?
  mfaSecret String?
  pendingMfaSecret String?
  pendingMfaAt DateTime?
  mfaLastStep Int @default(-1)
  recoveryHashes String @default("[]")
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
  tokens AccountToken[]
}

model Membership {
  id String @id @default(cuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  disabledAt DateTime?
  createdAt DateTime @default(now())
  sessions Session[]
  @@unique([accountId, userId])
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  membershipId String
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([accountId, revokedAt])
  @@index([membershipId])
  @@index([expiresAt])
}

model AccountToken {
  id String @id @default(cuid())
  tokenHash String @unique
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose String
  usedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([accountId, purpose])
}

model Invitation {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email String
  role String
  tokenHash String @unique
  invitedBy String
  acceptedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([businessId, email])
}

model MailOutbox {
  id String @id @default(cuid())
  payload String // encrypted recipient/subject/body; contains one-time links
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  sentAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
}

model AuthThrottle {
  id String @id
  attempts Int @default(0)
  windowAt DateTime @default(now())
}

model Subscription {
  id String @id @default(cuid())
  businessId String @unique
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan String @default("trial")
  status String @default("trialing")
  trialEndsAt DateTime
  seatLimit Int @default(5)
  dailyChatLimit Int @default(50)
  createdAt DateTime @default(now())
}

model QuotaBucket {
  id String @id
  used Int @default(0)
}

// Deployment-global operational metadata; no recipient/body/token material.
model WorkerHeartbeat {
  id String @id
  runId String
  startedAt DateTime
  finishedAt DateTime?
  ok Boolean?
}

// Actor-scoped presentation only; never financial/business policy.
model WorkspacePreference {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  config String @default("{}")
  updatedAt DateTime @updatedAt
  @@unique([businessId, userId])
}

model CashbookEntry {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  operationRef String @unique
  operation Operation @relation(fields: [operationRef], references: [ref], onDelete: Cascade)
  userId String
  kind String
  amount Int
  partyName String @default("")
  customerId String?
  supplierId String?
  occurredOn String
  dueOn String?
  note String @default("")
  openAmount Int @default(0)
  cashDelta Int @default(0)
  settlements String @default("[]")
  promiseRevision Int @default(0)
  promiseRef String?
  followupUserId String?
  dateSource String @default("user_day")
  lastNudgedOn String?
  recordedAt DateTime @default(now())
  @@index([businessId, dueOn, openAmount], map: "CashbookEntry_businessId_dueOn_openAmount_idx")
}
model ShopReminder {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId String
  subject String
  active Boolean @default(true)
  revision Int @default(0)
  createdAt DateTime @default(now())
  @@unique([businessId, userId, subject], map: "ShopReminder_businessId_userId_subject_key")
}

// A short-lived financial clarification, not inferred long-term personal memory.
model CashbookDialogue {
  conversationId String @id
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  state String
  lastTurnId String?
  lastInput String @default("")
  lastReply String @default("")
  resolved String?
  version Int @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// R41 — «موظف حقيقي»: an open multi-turn request the employee is holding while
// the owner feeds it information across messages (e.g. a new-item purchase
// whose supplier/total arrive after the quantity). One active request per
// conversation; expires like CashbookDialogue (20 min) so a stale «سجله كصنف
// جديد» never hijacks next week's question.
model PendingRequest {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String   @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  kind           String // purchase_new_item
  slots          String @default("{}") // JSON: { itemName, qty, unit, unitLabel, paid, supplierName, total, unitPrice }
  question       String @default("") // the exact question currently outstanding
  status         String @default("awaiting") // awaiting | resolved | cancelled
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt

  @@index([businessId, status])
}

// Explicit deployment-admin-selected ASR; never assume a chat model transcribes audio.
model SpeechSettings {
  id String @id
  providerId String
  provider ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  remoteId String
  updatedAt DateTime @updatedAt
}
